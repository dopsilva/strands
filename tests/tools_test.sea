local t = require("sea/test")
local strands = require("../strands")
local tools = strands.tools
local vended = strands.vended

local function run(tool, input)
    return tools.run(tool, {toolUseId = "id1", name = tool.name, input = input}, {})
end

t.describe("tool definition", function()
    t.it("builds a JSON Schema from the inputs", function()
        local tool = t.no_error(strands.tool({
            name = "busca",
            description = "Busca",
            inputs = {
                termo = {type = "string", description = "o que buscar"},
                limite = {type = "integer", default = 10},
                tags = {type = "array", items = "string", optional = true},
                filtro = {properties = {uf = "string"}},
            },
            fn = function(i) return i end,
        }))
        local s = tool:spec()
        t.eq(s.name, "busca")
        local schema = s.inputSchema.json
        t.eq(schema.required, ["termo", "filtro"]) -- in the order of the inputs
        t.eq(schema.properties.tags.items.type, "string")
        t.eq(schema.properties.filtro.type, "object")
        t.eq(schema.properties.filtro.required, ["uf"])
    end)

    t.it("rejects bad names, missing fn and unknown types", function()
        t.is_error(strands.tool({name = "tem espaço", fn = function() end}), "tool name")
        t.is_error(strands.tool({name = "x"}), "needs fn")
        t.is_error(strands.tool({name = "x", inputs = {a = {type = "texto"}}, fn = function() end}), "unknown type")
    end)

    t.it("validates input and fills defaults", function()
        local tool = t.no_error(strands.tool({
            name = "v", inputs = {
                n = {type = "integer", minimum = 1, maximum = 5},
                modo = {type = "string", enum = ["a", "b"], default = "a"},
            },
            fn = function(i) return i end,
        }))
        t.eq(run(tool, {n = 3}).content[0].json, {n = 3, modo = "a"})
        t.contains(strands.messages.result_text(run(tool, {n = 9})), "must be <= 5")
        t.contains(strands.messages.result_text(run(tool, {n = 2, modo = "c"})), "must be one of")
        t.contains(strands.messages.result_text(run(tool, {})), "input.n is required")
        t.contains(strands.messages.result_text(run(tool, {n = 1.5})), "must be a integer")
    end)

    t.it("turns return values into tool results", function()
        local function r(v)
            local tool = t.no_error(strands.tool({name = "r", fn = function() return v end}))
            return run(tool, {})
        end
        t.eq(r("texto").content[0].text, "texto")
        t.eq(r({a = 1}).content[0].json, {a = 1})
        t.eq(r([1, 2]).content[0].json, [1, 2])
        t.eq(r({status = "error", content = "x"}).status, "error")
        t.eq(r(error("ruim")).status, "error")
        t.eq(r([strands.messages.text_block("a"), strands.messages.text_block("b")]).content[1].text, "b")
    end)

    t.it("registers tools and refuses duplicates", function()
        local a = t.no_error(strands.tool({name = "a", fn = function() end}))
        local reg = t.no_error(tools.registry([a]))
        t.is_error(reg:add(a), "duplicate")
        t.eq(reg:names(), ["a"])
        t.ok(reg:remove("a"))
        t.eq(len(reg:specs()), 0)
    end)
end)

t.describe("ready-made tools", function()
    t.it("calculator", function()
        t.eq(vended.evaluate("2 + 3 * (4 - 1)^2"), 29)
        t.eq(vended.evaluate("sqrt(1764)"), 42)
        t.eq(vended.evaluate("-2^2"), -4)
        t.eq(vended.evaluate("max(1, 5, 3) + 10 // 3 + 7 % 4"), 11)
        t.near(vended.evaluate("sin(pi / 2)"), 1)
        t.is_error(vended.evaluate("1 / 0"), "division by zero")
        t.is_error(vended.evaluate("2 +"), "end of expression")
        t.is_error(vended.evaluate("system(1)"), "unknown function")
        t.eq(run(vended.calculator, {expression = "1/3", precision = 3}).content[0].text, "1/3 = 0.333")
    end)

    t.it("files and editor", function()
        local dir = fs.tempdir("strands-tools")
        local always = function(_) return true end
        local w = vended.file_write_tool({root = dir, confirm = always})
        local r = vended.file_read_tool({root = dir})
        local ed = vended.editor_tool({root = dir, confirm = always})
        t.eq(run(w, {path = "a/b.txt", content = "um\ndois\ntrês\n"}).status, "success")
        t.contains(strands.messages.result_text(run(r, {path = "a/b.txt", start_line = 2, end_line = 2})), "2  dois")
        t.eq(run(ed, {command = "str_replace", path = "a/b.txt", old_str = "dois", new_str = "2"}).status, "success")
        t.eq(fs.read(dir .. "/a/b.txt"), "um\n2\ntrês\n")
        t.contains(strands.messages.result_text(run(ed, {command = "str_replace", path = "a/b.txt", old_str = "x"})), "not found")
        t.eq(run(ed, {command = "undo_edit", path = "a/b.txt"}).status, "success")
        t.eq(fs.read(dir .. "/a/b.txt"), "um\ndois\ntrês\n")
        t.contains(strands.messages.result_text(run(r, {path = "../fora.txt"})), "outside")
        local denied = vended.file_write_tool({root = dir, confirm = function(_) return false end})
        t.contains(strands.messages.result_text(run(denied, {path = "x.txt", content = "x"})), "did not allow")
    end)

    t.it("shell and current_time", function()
        local sh = vended.shell_tool({confirm = function(_) return true end})
        local res = run(sh, {command = "echo oi && exit 2"})
        t.eq(res.status, "error")
        t.contains(strands.messages.result_text(res), "exit code: 2")
        t.contains(strands.messages.result_text(res), "oi")
        t.matches(strands.messages.result_text(run(vended.current_time, {timezone = "UTC"})), "^\\d{4}-\\d\\d-\\d\\dT")
    end)
end)
