-- handlers — callback handlers: functions called with every progress event
-- of an invocation (see stream.sea for the stream fields), plus
--   {init_event_loop = true}            the invocation starts
--   {start_event_loop = true}           a cycle starts
--   {message = msg}                     a message was added
--   {tool_result = result, tool_use}    a tool finished
--   {force_stop = true, force_stop_reason}
--   {result = result}                   the invocation ended

local M = {}

-- strands.handlers.printing({verbose_tool_use = true}) → handler
-- Prints the text as it streams and a line per tool call (the default).
function M.printing(opts)
    local verbose = not opts or opts.verbose_tool_use ~= false
    local count = 0
    local current = nil
    local line_start = true
    local function out(s)
        if s == "" then return end
        io.write(s)
        line_start = string.ends_with(s, "\n")
    end
    return function(e)
        if e.data ~= nil then
            out(e.data)
        elseif e.reasoningText ~= nil and opts and opts.show_reasoning then
            out(e.reasoningText)
        elseif e.current_tool_use ~= nil and verbose then
            local id = e.current_tool_use.toolUseId
            if id ~= nil and id ~= current then
                current = id
                count += 1
                out(`${line_start and "" or "\n"}Tool #${count}: ${e.current_tool_use.name}\n`)
            end
        elseif e.result ~= nil and not line_start then
            out("\n")
        end
    end
end

-- does nothing
function M.null()
    return function(_) end
end

-- calls several handlers
function M.composite(...)
    local hs = [...]
    return function(e)
        for _, h in hs do h(e) end
    end
end

return M
