# Copie para .env e preencha. O .env fica fora do git.

# chave da API da Maritaca: https://plataforma.maritaca.ai/chaves-de-api
MARITACA_API_KEY=

# modelo padrão: sabia-4, sabiazinho-4 ou sabia-4-thinking (-br-sp: inferência no Brasil)
MARITACA_MODEL=sabia-4

# true: shell e escrita de arquivos sem pedir confirmação
# BYPASS_TOOL_CONSENT=false
